# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — copie este arquivo para .env e preencha seus valores
#
#  Opção mais simples: rode  python setup.py  — ele preenche isso por você.
#  Opção manual:             cp .env.example .env  e edite o .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Moodle ────────────────────────────────────────────────────────────────────
MOODLE_BASE_URL=https://campusvirtual.facitec.edu.py
MOODLE_USER=seu_usuario
MOODLE_PASS=sua_senha

# ── Notion ────────────────────────────────────────────────────────────────────
# Token da integração: notion.so/my-integrations → sua integração → copie o token
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do banco de dados (extraído da URL da página do Notion)
NOTION_DB_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── WebDriver ─────────────────────────────────────────────────────────────────
HEADLESS=true           # false = abre o Chrome visualmente (útil para debug)
WAIT_TIMEOUT=20         # segundos de espera por elementos na página
PAGE_LOAD_TIMEOUT=30    # segundos de timeout de carregamento de página

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false             # true = logs detalhados (nível DEBUG)
LOOP_INTERVAL=3600      # segundos entre execuções no modo --loop
LOG_FILE=logs/moodle_sync.log
